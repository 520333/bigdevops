# ==========================================
# Alert Webhook 服务多阶段构建 Dockerfile
# ==========================================

# 1. 编译阶段
FROM golang:1.23-alpine AS builder

ENV CGO_ENABLED=0 \
    GOOS=linux \
    GOARCH=amd64 \
    GOPROXY=https://goproxy.cn,direct

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -ldflags="-s -w" -o /build/alert_webhook ./cmd/alert_webhook

# 2. 运行阶段
FROM alpine:3.20 AS runner

RUN apk add --no-cache ca-certificates tzdata \
    && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
    && echo "Asia/Shanghai" > /etc/timezone

WORKDIR /app

COPY --from=builder /build/alert_webhook /app/alert_webhook
COPY alert_webhook.yml /app/alert_webhook.yml

EXPOSE 8085

ENTRYPOINT ["/app/alert_webhook", "-config_file", "/app/alert_webhook.yml"]
